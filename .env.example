# SMS er deaktivert som standard. Bruk "sinch" først når konto og testverdier er klare.
NBR_SMS_PROVIDER=queue

# Sinch Conversation API. Verdiene skal legges inn som Railway Variables.
NBR_SINCH_CONVERSATION_REGION=us
NBR_SINCH_PROJECT_ID=
NBR_SINCH_APP_ID=
NBR_SINCH_ACCESS_KEY=
NBR_SINCH_KEY_SECRET=
NBR_SINCH_SMS_SENDER=

# Eldre Sinch SMS API, kun hvis denne varianten brukes.
NBR_SINCH_REGION=eu
NBR_SINCH_SERVICE_PLAN_ID=
NBR_SINCH_API_TOKEN=
NBR_SINCH_FROM=

# Testmottakere, separert med komma, semikolon eller linjeskift.
NBR_TEST_PERSONS=94848500,99003233
